 "stages": [
  {
   "id": "st1",
   "title": "凤阳孤儿",
   "from": "1328H2",
   "to": "1344H1",
   "summary": "生于钟离贫苦佃农之家，屡迁村落；十七岁遇旱蝗大疫，父母长兄相继死去，无地可葬。",
   "mood_hint": "淮河平原的贫瘠乡村，童年清苦、沉默坚忍；末段饥荒与丧亲，悲怆压抑。"
  },
  {
   "id": "st2",
   "title": "游方僧",
   "from": "1344H2",
   "to": "1351H2",
   "summary": "入皇觉寺为僧，不足两月寺中断粮，只身游食淮西、豫南三年，复归寺中。",
   "mood_hint": "孤身漂泊、风餐露宿，凄凉而倔强；“身如蓬逐风”的流离感，渐生隐忍与见识。"
  },
  {
   "id": "st3",
   "title": "濠州从军",
   "from": "1352H1",
   "to": "1355H1",
   "summary": "投郭子兴红巾军，娶马氏；还乡募兵，南略定远，取滁州、和州，渐成一军之主。",
   "mood_hint": "乱世揭竿，由小卒崛起；隐忍果决、在派系夹缝中求生，节奏紧张上扬。"
  },
  {
   "id": "st4",
   "title": "渡江定鼎",
   "from": "1355H2",
   "to": "1359H2",
   "summary": "渡江拔采石、太平，取集庆改应天府，称吴国公，经略江南、浙东。",
   "mood_hint": "大江横渡、背水一战的豪壮，继而奠基立业的沉稳开阔。"
  },
  {
   "id": "st5",
   "title": "群雄逐鹿",
   "from": "1360H1",
   "to": "1367H2",
   "summary": "龙湾诱败陈友谅，鄱阳湖决战灭汉；称吴王，平张士诚，遣将北伐中原。",
   "mood_hint": "雄略果敢、以弱制强；水战烈火、鼓角连天的史诗感，胜局渐定。"
  },
  {
   "id": "st6",
   "title": "开国称帝",
   "from": "1368H1",
   "to": "1375H1",
   "summary": "应天即皇帝位，国号大明；北巡汴梁，营建中都又罢之，定礼制律令、封诸王功臣。",
   "mood_hint": "开国气象庄严恢宏，夹杂对故乡的眷恋与对功臣、制度的审慎经营。"
  },
  {
   "id": "st7",
   "title": "洪武治国",
   "from": "1375H2",
   "to": "1391H2",
   "summary": "长居南京勤政：诛胡惟庸、废丞相，设锦衣卫，颁《大诰》，编黄册与鱼鳞图册，丧马皇后。",
   "mood_hint": "勤政严苛、猜忌日深，宫廷肃杀压抑；铁腕之下亦有恤民之政，冷峻沉重。"
  },
  {
   "id": "st8",
   "title": "晚年孤寂",
   "from": "1392H1",
   "to": "1398H1",
   "summary": "太子朱标早逝，立皇太孙；兴蓝玉案、诛宿将，立祖训，崩于南京，葬孝陵。",
   "mood_hint": "白发丧子、故旧凋零，猜忌严酷与晚年孤寂交织，终归苍凉沉寂。"
  }
 ],
