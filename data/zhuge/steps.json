 "stages": [
  {
   "id": "st1",
   "title": "乱世少年",
   "from": "181H1",
   "to": "195H1",
   "summary": "生于琅琊阳都，早年失怙，徐州兵祸中随叔父诸葛玄南下豫章。",
   "mood_hint": "幼年孤苦、颠沛流离；北方战火的阴影下，少年沉静早慧，旋律低回而带不安。"
  },
  {
   "id": "st2",
   "title": "隆中躬耕",
   "from": "195H2",
   "to": "207H1",
   "summary": "依刘表寓居襄阳，叔父卒后躬耕隆中，好为《梁父吟》，自比管仲、乐毅。",
   "mood_hint": "田园隐逸而胸怀天下；从容、自负、蓄势待时，旋律舒缓开阔，暗含抱负。"
  },
  {
   "id": "st3",
   "title": "出山与赤壁",
   "from": "207H2",
   "to": "208H2",
   "summary": "刘备三顾，草庐定策；随刘备南撤，出使柴桑联吴，赤壁破曹。",
   "mood_hint": "知遇之感与临危受命；节奏由沉郁转为急促昂扬，危局中显出果决与辩才。"
  },
  {
   "id": "st4",
   "title": "经营荆益",
   "from": "209H1",
   "to": "220H2",
   "summary": "督三郡赋税以充军实，镇守荆州，溯江入蜀；坐镇成都，足食足兵。",
   "mood_hint": "务实干练、勤勉持重；建设与积累的稳定推进感，基调明朗而克制。"
  },
  {
   "id": "st5",
   "title": "丞相辅政",
   "from": "221H1",
   "to": "226H2",
   "summary": "刘备称帝拜丞相；白帝城受托孤，独掌国政，联吴、南征，安定南中。",
   "mood_hint": "受命于危难之间，责任沉重；庄严、悲怆中带坚毅，托孤一节尤显哀痛。"
  },
  {
   "id": "st6",
   "title": "北伐中原",
   "from": "227H1",
   "to": "234H2",
   "summary": "上《出师表》进驻汉中，五次出兵秦陇，屯田渭滨，终卒于五丈原。",
   "mood_hint": "鞠躬尽瘁、明知难为而为之；悲壮苍凉，铁血与疲惫交织，终章寂灭。"
  }
 ],
