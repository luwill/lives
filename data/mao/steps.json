 "stages": [
  {
   "id": "st1",
   "title": "韶山少年",
   "from": "1893H2",
   "to": "1910H1",
   "summary": "生于湘潭韶山冲农家，读私塾、务农，在父亲的严厉管教下倔强求学。",
   "mood_hint": "湘中山村的宁静与少年的倔强：读书入迷、与父亲顶撞，内心渴望走出山冲。"
  },
  {
   "id": "st2",
   "title": "求学长沙",
   "from": "1910H2",
   "to": "1918H1",
   "summary": "走出韶山，东山学堂、新军、湖南第一师范，广交师友，创立新民学会。",
   "mood_hint": "青春激昂、求知若渴，“粪土当年万户侯”的书生意气与救国抱负。"
  },
  {
   "id": "st3",
   "title": "建党与农运",
   "from": "1918H2",
   "to": "1927H1",
   "summary": "两度进京、接受马克思主义，出席中共一大，领导湖南工运，转向农民运动。",
   "mood_hint": "思想激荡、奔走四方：从书生到职业革命家，热血、果决，寻找中国出路的焦灼与坚定。"
  },
  {
   "id": "st4",
   "title": "井冈山与中央苏区",
   "from": "1927H2",
   "to": "1934H1",
   "summary": "秋收起义上井冈山，朱毛会师，转战赣南闽西，创建中央苏区，又遭“左”倾排挤。",
   "mood_hint": "艰苦而豪迈：山沟里的星星之火、马背上的诗词；后期受排挤、养病，隐忍沉郁。"
  },
  {
   "id": "st5",
   "title": "长征",
   "from": "1934H2",
   "to": "1935H2",
   "summary": "离开于都踏上长征，湘江血战后转兵贵州，遵义会议重掌军事指挥，四渡赤水、翻雪山过草地，落脚陕北。",
   "mood_hint": "悲壮与绝处逢生：湘江的惨烈、娄山关的苍凉，雪山草地的坚忍，终至“三军过后尽开颜”的豪迈。"
  },
  {
   "id": "st6",
   "title": "陕北与延安",
   "from": "1936H1",
   "to": "1946H2",
   "summary": "东征、保安，进驻延安十年：领导抗战，著述立说，整风，七大确立领袖地位，赴重庆谈判。",
   "mood_hint": "从容自信的窑洞岁月：油灯下著书、黄土高原上的大生产，沉稳、睿智，间有《沁园春·雪》的气吞山河。"
  },
  {
   "id": "st7",
   "title": "转战陕北·西柏坡",
   "from": "1947H1",
   "to": "1949H1",
   "summary": "撤离延安转战陕北一年，东渡黄河进驻西柏坡，指挥三大战役，进入北平。",
   "mood_hint": "“最小的司令部指挥最大的战争”：颠沛中的镇定、决战前的紧张，终而“宜将剩勇追穷寇”的胜利豪情。"
  },
  {
   "id": "st8",
   "title": "建国之后",
   "from": "1949H2",
   "to": "1976H2",
   "summary": "开国大典、两度访苏，常驻中南海而频繁南下巡视；大跃进、庐山会议、文化大革命，晚年病逝北京。",
   "mood_hint": "宏阔而复杂：开国的雄浑、巡视大江南北的豪兴（游泳长江），继而政治风暴的激烈，晚年病中苍凉孤寂。"
  }
 ],
