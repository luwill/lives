"subs": [
[
5.506,
10.794,
"公元一八一年，琅琊阳都的一户官宦人家生下一个男孩"
],
[
11.289,
14.967,
"五十四年后，他死在五丈原的军营里"
],
[
15.442,
17.842,
"半年一步，我们沿着史料"
],
[
17.942,
19.939,
"走一遍诸葛亮的一生"
],
[
27.261,
30.424,
"诸葛亮，字孔明，琅琊阳都人"
],
[
30.538,
32.577,
"在今天的山东沂南"
],
[
33.072,
35.93,
"他是西汉司隶校尉诸葛丰的后代"
],
[
36.086,
38.888,
"父亲诸葛圭做过泰山郡丞"
],
[
39.349,
42.222,
"他出生的月份，史书没有记载"
],
[
44.749,
47.871,
"此后十余年，史书几乎空白"
],
[
47.901,
49.746,
"只知他早年丧父"
],
[
50.24,
53.307,
"黄巾、董卓、曹操攻徐州"
],
[
53.407,
55.21,
"战火逼近琅琊"
],
[
60.944,
64.996,
"约在这时，叔父诸葛玄出任豫章太守"
],
[
65.166,
67.885,
"带着诸葛亮和弟弟诸葛均南下"
],
[
67.985,
69.566,
"到了今天的南昌"
],
[
70.06,
73.446,
"南下的确切年份，史家说法不一"
],
[
79.934,
82.959,
"不久，朝廷另派朱皓接任豫章"
],
[
83.17,
85.889,
"诸葛玄失去官职，转投老友"
],
[
85.934,
89.209,
"荆州牧刘表，一家人寓居襄阳"
],
[
93.029,
98.123,
"叔父去世后，诸葛亮在襄阳城西的隆中躬耕陇亩"
],
[
98.279,
99.831,
"好为《梁父吟》"
],
[
100.312,
102.476,
"他常自比管仲、乐毅"
],
[
102.617,
104.392,
"时人大多不以为然"
],
[
104.423,
108.365,
"只有崔州平、徐庶几位朋友深信不疑"
],
[
110.901,
114.787,
"隆中十年，他娶了名士黄承彦之女"
],
[
115.267,
117.764,
"山外，刘备屯驻新野"
],
[
117.906,
120.653,
"徐庶对刘备说：诸葛孔明"
],
[
120.753,
121.862,
"卧龙也"
],
[
129.076,
132.545,
"建安十二年，刘备三次前往隆中"
],
[
132.617,
134.198,
"才见到诸葛亮"
],
[
134.664,
137.676,
"二十七岁的诸葛亮为他纵论天下"
],
[
