"subs": [
[
5.51,
10.987,
"公元一八一年，琅琊阳都的一户官宦人家生下一个男孩"
],
[
11.531,
14.999,
"五十三年后，他死在五丈原的军营里"
],
[
15.519,
17.701,
"半年一步，我们沿着史料"
],
[
17.721,
19.687,
"走一遍诸葛亮的一生"
],
[
26.713,
29.824,
"诸葛亮，字孔明，琅琊阳都人"
],
[
29.867,
31.907,
"在今天的山东沂南"
],
[
32.451,
35.563,
"他是西汉司隶校尉诸葛丰的后代"
],
[
35.71,
38.747,
"父亲诸葛圭做过泰山郡丞"
],
[
39.267,
42.274,
"他出生的月份，史书没有记载"
],
[
42.793,
45.154,
"诸葛一门后来分散三国"
],
[
45.174,
47.557,
"兄长诸葛瑾仕于东吴"
],
[
47.66,
49.893,
"族弟诸葛诞仕于曹魏"
],
[
50.055,
53.301,
"而他自己，将把一生交给蜀汉"
],
[
55.553,
58.494,
"此后十余年，史书几乎空白"
],
[
58.514,
60.271,
"只知他早年丧父"
],
[
60.815,
63.92,
"黄巾、董卓、曹操攻徐州"
],
[
63.94,
65.742,
"战火逼近琅琊"
],
[
71.748,
75.805,
"约在这时，叔父诸葛玄出任豫章太守"
],
[
75.825,
78.713,
"带着诸葛亮和弟弟诸葛均南下"
],
[
78.756,
80.32,
"到了今天的南昌"
],
[
80.864,
84.199,
"南下的确切年份，史家说法不一"
],
[
90.402,
93.691,
"不久，朝廷另派朱皓接任豫章"
],
[
93.75,
96.81,
"诸葛玄失去官职，转投老友"
],
[
96.83,
100.15,
"荆州牧刘表，一家人寓居襄阳"
],
[
103.689,
108.586,
"叔父去世后，诸葛亮在襄阳城西的隆中躬耕陇亩"
],
[
108.614,
110.312,
"好为《梁父吟》"
],
[
110.841,
113.164,
"他常自比管仲、乐毅"
],
[
113.222,
115.172,
"时人大多不以为然"
],
[
115.201,
119.116,
"只有崔州平、徐庶几位朋友深信不疑"
],
[
119.65,
122.621,
"据《魏略》，他与石韬、徐庶"
],
[
122.641,
