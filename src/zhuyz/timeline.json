],
[
280.707,
283.425,
"积蓄多年之后，他才称王"
],
[
287.53,
290.044,
"湖广、江西相继平定"
],
[
290.524,
292.821,
"他转而对付东边的张士诚"
],
[
292.915,
294.111,
"先取淮东"
],
[
297.913,
299.843,
"至正二十六年四月"
],
[
