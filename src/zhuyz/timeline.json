],
[
149.656,
152.524,
"随后南下取定远、滁州"
],
[
152.686,
153.339,
"和州"
],
[
160.507,
163.973,
"至正十五年六月，他率军渡过长江"
],
[
164.217,
166.608,
"常遇春率先登上采石矶"
],
[
167.088,
168.841,
"为了不给将士留退路"
],
[
169.004,
172.442,
"他命人砍断船缆，放船顺流而去"
],
[
172.618,
174.276,
"第二天攻克太平"
],
[
180.19,
184.226,
"第二年三月，他攻下元朝的江南重镇集庆"
],
[
184.307,
187.392,
