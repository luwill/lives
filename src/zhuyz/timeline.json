"subs": [
[
5.504,
9.758,
"元朝天历元年，濠州钟离一户佃农家里"
],
[
9.839,
11.619,
"生下了第四个儿子"
],
[
12.085,
15.251,
"从放牛娃、游方僧到开国皇帝"
],
[
15.373,
17.683,
"半年一步，我们沿着史料"
],
[
17.751,
19.694,
"走一遍朱元璋的一生"
],
[
26.995,
28.925,
"朱元璋生在濠州钟离"
],
[
29.02,
31.153,
"就是今天的安徽凤阳"
],
[
31.633,
33.603,
"父亲朱世珍是佃农"
],
[
33.752,
36.593,
"一家人租地耕种，几度迁居"
],
[
37.068,
38.916,
"他在家里排行第四"
],
[
41.435,
43.297,
"童年在贫困中度过"
],
[
43.446,
46.613,
"他给人放牛，两个哥哥先后出赘"
],
[
59.83,
62.181,
"至正四年，淮北大旱"
],
[
62.344,
64.247,
"蝗灾之后又是瘟疫"
],
[
64.726,
67.43,
"半个多月里，父亲、长兄"
],
[
67.538,
69.496,
"母亲相继病死"
],
[
69.971,
72.539,
"家里没有棺材，也没有葬地"
],
[
72.634,
75.379,
"同乡刘继祖施舍了一块地"
],
[
75.84,
78.748,
"多年以后，他在《皇陵碑》里写道"
],
[
78.884,
81.33,
"殡无棺椁，被体恶裳"
],
[
89.117,
94.43,
"这年九月，十七岁的他进了村里的皇觉寺当小和尚"
],
[
94.91,
97.206,
"不到两个月，寺里断了粮"
],
[
97.383,
99.149,
"僧人们各自散去"
],
[
101.661,
103.931,
"此后三年，他托钵游方"
],
[
104.039,
106.811,
"西到合肥，经光州、固始"
],
[
106.906,
110.086,
"北到汝州、颍州，一路乞食"
],
[
111.997,
114.416,
"他回到皇觉寺读书识字"
],
[
114.896,
117.41,
"至正十一年，红巾军起"
],
[
124.604,
127.852,
"至正十二年，郭子兴占据濠州"
],
[
128.332,
130.696,
"儿时的伙伴写信招他从军"
],
[
130.832,
133.74,
"他犹豫不决，还在神前占卜"
],
[
134.215,
138.264,
"闰三月，二十五岁的他走进濠州城投军"
],
[
138.332,
140.166,
"被郭子兴留作亲兵"
],
[
142.668,
144.829,
"他娶了郭子兴的养女马氏"
],
[
144.965,
148.375,
"回乡招兵，徐达、汤和都在其中"
],
[
148.551,
151.188,
"随后南下取定远、滁州"
],
[
151.296,
151.962,
"和州"
],
[
159.139,
162.605,
"至正十五年六月，他率军渡过长江"
],
[
162.849,
165.24,
"常遇春率先登上采石矶"
],
[
165.72,
167.473,
"为了不给将士留退路"
],
[
167.636,
171.074,
"他命人砍断船缆，放船顺流而去"
],
[
171.25,
172.908,
"第二天攻克太平"
],
[
178.822,
182.858,
"第二年三月，他攻下元朝的江南重镇集庆"
],
[
182.939,
186.024,
"改名应天府，就是今天的南京"
],
[
186.503,
189.778,
"他对城中百姓说：我来为民除乱"
],
[
189.846,
191.001,
"各安生业"
],
[
191.476,
194.017,
"从此，他有了立足的根本"
],
[
196.526,
199.407,
"他被推为吴国公，亲征宁国"
],
[
199.502,
200.155,
"婺州"
],
[
200.607,
203.61,
"西边是陈友谅，东边是张士诚"
],
[
210.813,
212.77,
"至正二十年闰五月"
],
[
212.974,
215.515,
"陈友谅率大军顺江东下"
],
[
215.542,
216.751,
"直逼应天"
],
[
217.231,
219.283,
"他用诈降计诱敌深入"
],
[
219.323,
222.381,
"在龙湾伏兵夹击，陈友谅大败"
],
[
222.502,
223.943,
"乘小船逃走"
],
[
227.953,
230.821,
"此后他溯江西上，攻取江州"
],
[
230.929,
234.679,
"洪都，又北上安丰，救出小明王韩林儿"
],
[
238.48,
243.1,
"至正二十三年夏，陈友谅倾全力围攻洪都"
],
[
243.58,
248.675,
"他亲率水师驰援，两军在鄱阳湖鏖战三十多天"
],
[
249.123,
251.094,
"他用小船火攻巨舰"
],
[
251.202,
253.472,
