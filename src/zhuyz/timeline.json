],
[
321.503,
322.726,
"围困平江"
],
[
326.54,
329.951,
"九月，平江城破，张士诚被俘"
],
[
330.431,
332.863,
"东南已定，他坐镇应天"
],
[
332.985,
335.689,
"定下先取山东、再取河南"
],
[
335.757,
338.257,
"扼守潼关的方略，命徐达"
],
[
338.352,
340.309,
"常遇春北伐中原"
],
[
348.099,
353.344,
