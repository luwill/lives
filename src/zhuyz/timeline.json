],
[
402.677,
404.349,
"此案此后一再追究"
],
[
404.511,
406.998,
"到洪武二十三年李善长案"
],
[
407.242,
410.164,
"据《明史》，坐诛者三万余人"
],
[
412.67,
415.13,
