],
[
483.336,
485.321,
"忧危积心，日勤不怠"
],
[
485.429,
486.788,
"务有益于民"
],
[
491.289,
493.939,
"七十一年，一百四十个半年"
],
[
494.419,
497.626,
"从放牛娃、游方僧到开国皇帝"
],
[
497.775,
499.487,
