"subs": [
[
5.504,
9.758,
"元朝天历元年，濠州钟离一户佃农家里"
],
[
9.839,
11.619,
"生下了第四个儿子"
],
[
12.085,
15.251,
"从放牛娃、游方僧到开国皇帝"
],
[
15.373,
17.683,
"半年一步，我们沿着史料"
],
[
17.751,
19.694,
"走一遍朱元璋的一生"
],
[
26.995,
28.925,
"朱元璋生在濠州钟离"
],
[
29.02,
31.153,
"就是今天的安徽凤阳"
],
[
31.633,
33.603,
"父亲朱世珍是佃农"
],
[
33.752,
36.593,
"一家人租地耕种，几度迁居"
],
[
37.068,
38.916,
"他在家里排行第四"
],
[
41.435,
43.297,
"童年在贫困中度过"
],
[
43.446,
46.613,
"他给人放牛，两个哥哥先后出赘"
],
[
59.83,
62.181,
"至正四年，淮北大旱"
],
[
62.344,
64.247,
"蝗灾之后又是瘟疫"
],
[
64.726,
67.43,
"半个多月里，父亲、长兄"
],
[
67.538,
69.496,
"母亲相继病死"
],
[
69.971,
72.539,
"家里没有棺材，也没有葬地"
],
[
72.634,
75.379,
"同乡刘继祖施舍了一块地"
],
[
75.84,
78.748,
"多年以后，他在《皇陵碑》里写道"
],
[
78.884,
81.33,
"殡无棺椁，被体恶裳"
],
[
89.117,
94.43,
"这年九月，十七岁的他进了村里的皇觉寺当小和尚"
],
[
94.91,
97.206,
"不到两个月，寺里断了粮"
],
[
97.383,
99.149,
"僧人们各自散去"
],
[
101.661,
103.931,
"此后三年，他托钵游方"
],
[
104.039,
106.811,
"西到合肥，经光州、固始"
],
[
106.906,
110.086,
"北到汝州、颍州，一路乞食"
],
[
111.997,
114.416,
"他回到皇觉寺读书识字"
],
[
114.896,
117.41,
"至正十一年，红巾军起"
],
[
124.604,
127.852,
"至正十二年，郭子兴占据濠州"
],
[
128.332,
130.696,
"儿时的伙伴写信招他从军"
],
[
130.832,
133.74,
"他犹豫不决，还在神前占卜"
],
[
134.215,
138.264,
"闰三月，二十五岁的他走进濠州城投军"
],
[
138.332,
140.166,
"被郭子兴留作亲兵"
],
[
142.668,
144.87,
"他娶了郭子兴的养女马氏"
],
[
144.992,
149.177,
