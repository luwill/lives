],
[
253.593,
256.04,
"烟焰涨天，湖水尽赤"
],
[
256.501,
258.893,
"陈友谅中流矢而死"
],
[
264.864,
268.425,
"第二年正月，他在应天自立为吴王"
],
[
268.89,
270.82,
"谋士朱升曾经献策"
],
[
270.928,
273.932,
"高筑墙，广积粮，缓称王"
],
[
274.38,
277.097,
"积蓄多年之后，他才称王"
],
[
281.218,
283.732,
"湖广、江西相继平定"
],
[
284.212,
286.509,
"他转而对付东边的张士诚"
],
[
286.603,
287.799,
"先取淮东"
],
[
291.601,
293.531,
"至正二十六年四月"
],
[
293.748,
296.928,
"他回到濠州，祭扫父母的坟墓"
],
[
297.407,
300.193,
"他对乡亲们说：我离乡十多年"
],
[
300.22,
303.522,
"艰难百战，今天才得以回来扫墓"
],
[
303.576,
305.397,
"与父老子弟再相见"
],
[
309.389,
311.523,
"回到应天，他派徐达"
],
[
311.618,
315.096,
"常遇春率二十万大军进攻张士诚"
],
[
315.191,
316.414,
"围困平江"
],
[
320.228,
323.639,
"九月，平江城破，张士诚被俘"
],
[
324.119,
326.551,
"东南已定，他坐镇应天"
],
[
326.673,
329.377,
"定下先取山东、再取河南"
],
[
329.445,
331.945,
"扼守潼关的方略，命徐达"
],
[
332.04,
333.997,
"常遇春北伐中原"
],
[
341.787,
347.032,
"洪武元年正月，四十一岁的朱元璋在应天南郊即皇帝位"
],
[
347.168,
349.573,
"国号大明，年号洪武"
],
[
350.053,
352.893,
"这年八月，徐达攻入元大都"
],
[
352.987,
354.428,
"元顺帝北走"
],
[
354.876,
358.273,
"从投军到登基，他只用了十六年"
],
[
362.263,
364.75,
"建国之初，他北巡汴梁"
],
[
364.845,
367.305,
"在故乡临濠营建中都"
],
[
369.215,
372.816,
"洪武八年，他视察中都后下令停建"
],
[
378.127,
381.402,
