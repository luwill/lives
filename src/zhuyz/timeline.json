],
[
434.519,
437.78,
"太子朱标病逝，年仅三十八岁"
],
[
438.246,
440.964,
"他悉心培养了二十多年的继承人"
],
[
441.058,
442.187,
"先他而去"
],
[
442.648,
447.024,
"这年九月，他立朱标之子朱允炆为皇太孙"
],
[
451.97,
455.748,
"次年二月，大将军蓝玉以谋反罪被杀"
],
[
456.2,
459.733,
"据《明史》，因此案族诛者一万五千人"
],
[
459.923,
462.587,
"开国功臣几乎被一网打尽"
],
[
465.09,
468.977,
