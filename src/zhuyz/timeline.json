],
[
200.87,
201.523,
"婺州"
],
[
201.975,
204.978,
"西边是陈友谅，东边是张士诚"
],
[
212.181,
214.138,
"至正二十年闰五月"
],
[
214.342,
216.883,
"陈友谅率大军顺江东下"
],
[
216.91,
218.119,
"直逼应天"
],
[
218.599,
220.651,
"他用诈降计诱敌深入"
],
[
220.691,
223.749,
